---
import Layout from '../../layouts/Layout.astro';
import ExploreCard from './ExploreCard.astro';
import { Code2, Award, Monitor, Folder } from 'lucide-astro';
---

<Layout title="Home">
    <div class="mx-auto min-h-[calc(100vh-149px)] w-[calc(100%-48px)] max-w-240">
        <section class="pt-27.5 pb-22.5 max-[600px]:py-17.5">
            <h1 class="mt-4 mb-6.5 text-[clamp(32px,5vw,46px)] leading-[1.3] font-bold">
                Welcome!
            </h1>
            <p class="text-[16px] leading-loose text-[#555]">
                Webアプリケーション開発を中心に、クラウド、セキュリティ、AIなどの技術に興味を持っています。
                <br />
                このポートフォリオサイトでは、スキルや資格、開発環境などを紹介しています。
            </p>
            <br />
            <div class="flex items-center gap-3">
                <a
                    href="/about"
                    class="inline-flex items-center gap-2 rounded-md bg-neutral-900 px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-neutral-700"
                >
                    About me
                </a>
                <span aria-hidden="true">or</span>
                <a
                    href="/works"
                    class="inline-flex items-center gap-2 rounded-md border border-neutral-900 px-5 py-3 text-sm font-medium text-neutral-900 transition-colors hover:bg-neutral-300"
                >
                    Works
                </a>
            </div>
        </section>
        <section class="pb-25 max-[600px]:pb-17.5" aria-label="ページ一覧">
            <h2 class="mb-5 text-xl font-bold">Explore</h2>
            <div class="grid grid-cols-2 gap-3 max-[600px]:grid-cols-1">
                <ExploreCard title="Skills" href="/skills">
                    <Code2 slot="icon" size={22} />
                </ExploreCard>
                <ExploreCard title="Qualifications" href="/qualifications">
                    <Award slot="icon" size={22} />
                </ExploreCard>
                <ExploreCard title="Uses" href="/uses">
                    <Monitor slot="icon" size={22} />
                </ExploreCard>
                <ExploreCard title="Works" href="/works">
                    <Folder slot="icon" size={22} />
                </ExploreCard>
            </div>
        </section>
    </div>
</Layout>
