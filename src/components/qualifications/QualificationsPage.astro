---
import Layout from '../../layouts/Layout.astro';

const nationalQualifications = [
    {
        name: '情報処理安全確保支援士試験',
        date: '2025年12月',
    },
    { name: '応用情報技術者試験', date: '2024年12月' },
    { name: '基本情報技術者試験', date: '2024年7月' },
    { name: 'ITパスポート試験', date: '2022年8月' },
];

const otherQualifications = [
    {
        name: 'G検定（ジェネラリスト）',
        date: '2025年8月',
    },
    {
        name: 'SEA/J 情報セキュリティ技術認定 基礎コース（CSBM）',
        date: '2025年3月',
    },
];
---

<Layout title="Qualifications">
    <div class="mx-auto min-h-[calc(100vh-149px)] w-[calc(100%-48px)] max-w-240 pt-20 pb-25 max-[600px]:pt-14 max-[600px]:pb-17.5">
        <header class="mb-12 max-[600px]:mb-8">
            <h1 class="text-[clamp(32px,5vw,46px)] leading-[1.3] font-bold">
                Qualifications
            </h1>
        </header>

        <div class="border-t border-neutral-300">
            <section
                aria-labelledby="national"
                class="border-b border-neutral-300 py-10"
            >
                <h2 id="national" class="mb-4 text-sm text-neutral-500">
                    NATIONAL QUALIFICATIONS
                </h2>
                <ul class="divide-y divide-neutral-200">
                    {nationalQualifications.map((qualification) => (
                        <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                            <span class="text-[15px] font-semibold text-neutral-900">
                                {qualification.name}
                            </span>
                            <span class="shrink-0 text-sm text-neutral-600">
                                {qualification.date}
                            </span>
                        </li>
                    ))}
                </ul>
            </section>

            <section
                aria-labelledby="other"
                class="border-b border-neutral-300 py-10"
            >
                <h2 id="other" class="mb-4 text-sm text-neutral-500">
                    OTHER QUALIFICATIONS
                </h2>
                <ul class="divide-y divide-neutral-200">
                    {otherQualifications.map((qualification) => (
                        <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                            <span class="text-[15px] font-semibold text-neutral-900">
                                {qualification.name}
                            </span>
                            <span class="shrink-0 text-sm text-neutral-600">
                                {qualification.date}
                            </span>
                        </li>
                    ))}
                </ul>
            </section>
        </div>
    </div>
</Layout>
