---
import Layout from '../../layouts/Layout.astro';

const items = [
    // Editor
    {
        name: 'Zed',
        category: 'Editor',
        description:
            'メインのエディタとして使用。元はVS Codeを使用していましたが、メモリの使用量が多かったため、軽量なZedに移行しました。現在はVimモードも学習しています。',
    },
    {
        name: 'Visual Studio Code',
        category: 'Editor',
        description:
            '現在はZedに移行。VS Codeでしか利用できない拡張機能を使用する場合に限定して利用しています。',
    },

    // Terminal
    {
        name: 'Git Bash',
        category: 'Terminal',
        description:
            'Windows環境でLinux系のコマンドを使用するために導入。ファイル操作やGitの操作、開発サーバーの起動などに使用しています。',
    },

    // AI & Development
    {
        name: 'Codex',
        category: 'AI & Development',
        description:
            '主にコードの実装や修正に使用。実装したい機能や設計方針を伝え、生成されたコードの差分を確認しながら開発を進めています。',
    },
    {
        name: 'OpenCode',
        category: 'AI & Development',
        description:
            '複数のAIモデルを利用した開発に使用。GLMやDeepSeekなどのモデルを切り替え、コードの実装や修正、技術調査などに利用しています。',
    },
    {
        name: 'ChatGPT',
        category: 'AI & Development',
        description:
            '主に技術調査や設計方針の検討に使用。最新のフレームワークやAIに関するニュースの収集、技術選定時の比較や実装上の問題解決などにも利用しています。',
    },
    {
        name: 'MCP Server',
        category: 'AI & Development',
        description:
            'AIエージェントと外部ツールを連携させるために使用。Astahやdraw.ioなどと連携し、UMLやシステム構成図の作成・編集などに利用しています。',
    },
    {
        name: 'Computer Use',
        category: 'AI & Development',
        description:
            'AIエージェントによるGUI操作に使用。ブラウザやアプリケーションを直接操作する必要がある作業で利用しています。',
    },

    // Development & Deployment
    {
        name: 'GitHub',
        category: 'Development & Deployment',
        description:
            '個人開発やチーム開発でのソースコード管理に使用。リポジトリを作成し、変更履歴の管理やコードの共有を行っています。',
    },
    {
        name: 'GitHub Actions',
        category: 'Development & Deployment',
        description:
            'CIによる品質チェックの自動化に使用。PushやPull Requestを行った際に、Lintによる静的解析やPrettierによるコードの整形チェック、PlaywrightによるE2Eテストを自動実行するようにしています。',
    },
    {
        name: 'Cloudflare Pages',
        category: 'Development & Deployment',
        description:
            '静的Webサイトのホスティングに使用。GitHubと連携させ、ソースコードの変更に応じて自動でビルド・デプロイされるように設定しています。',
    },
    {
        name: 'Wrangler',
        category: 'Development & Deployment',
        description:
            'Cloudflare Workersのローカル開発に使用。Honoで構築したAPIの動作確認や、Workers AIを使用した画像判定処理の検証などに利用しています。',
    },

    // Testing & Quality
    {
        name: 'Playwright',
        category: 'Testing & Quality',
        description:
            'WebアプリケーションのE2Eテストに使用。ブラウザ上での画面遷移や操作後の表示を検証し、GitHub Actionsと組み合わせてテストを自動化しています。',
    },

    // Design & Documentation
    {
        name: 'Penpot',
        category: 'Design & Documentation',
        description:
            'UIのデザインやレイアウトの検討に使用。画面構成やコンポーネントの配置を視覚的に確認する際に利用しています。',
    },
];

const categories = [...new Set(items.map((item) => item.category))];
---

<Layout title="Uses">
    <div class="mx-auto min-h-[calc(100vh-149px)] w-[calc(100%-48px)] max-w-240 pt-20 pb-25 max-[600px]:pt-14 max-[600px]:pb-17.5">
        <header class="mb-12 max-[600px]:mb-8">
            <h1 class="text-[clamp(32px,5vw,46px)] leading-[1.3] font-bold">
                Uses
            </h1>
        </header>
        <div class="space-y-10">
            {categories.map((category) => (
                <section aria-label={category}>
                    <h2 class="border-b border-neutral-300 pb-4 text-sm text-neutral-500">
                        {category}
                    </h2>
                    <ul
                        class="divide-y divide-neutral-200"
                        aria-label={`${category}のツール`}
                    >
                        {items
                            .filter((item) => item.category === category)
                            .map((item) => (
                                <li class="py-6">
                                    <h3 class="text-base font-semibold">
                                        {item.name}
                                    </h3>
                                    <p class="mt-2 text-[15px] leading-loose text-neutral-600">
                                        {item.description}
                                    </p>
                                </li>
                            ))}
                    </ul>
                </section>
            ))}
        </div>
    </div>
</Layout>
