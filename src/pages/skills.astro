---
import Layout from '../layouts/Layout.astro';
import SkillsExplorer from '../components/SkillsExplorer';

const items = [
    // Frontend
    {
        name: 'TypeScript',
        category: 'Frontend',
        description:
            'Webアプリケーションやモバイルアプリケーションの開発に使用。フロントエンドからバックエンドまで幅広く対応可能なため、個人開発の中心的な言語として採用しています。',
    },
    {
        name: 'JavaScript',
        category: 'Frontend',
        description:
            '初めてWeb開発に取り組んだ際に使用した言語。現在はTypeScriptに移行しています。',
    },
    {
        name: 'HTML / CSS',
        category: 'Frontend',
        description:
            'ReactやVueなどを用いたフロントエンド開発で使用。現在はスタイリングにTailwind CSSを主に利用しています。',
    },
    {
        name: 'React',
        category: 'Frontend',
        description:
            '主にNext.jsやReact Nativeで使用。useStateなどのHooksを活用したコンポーネントの状態管理や、React Router・Expo Routerを利用した画面遷移の実装を経験しています。',
    },
    {
        name: 'Vue.js',
        category: 'Frontend',
        description:
            'Nuxtで使用。Composition APIやPiniaを活用した状態管理、Vue Routerを利用した画面遷移の実装を経験しています。',
    },
    {
        name: 'Svelte',
        category: 'Frontend',
        description:
            'SvelteKitでSvelte 5を使用。Runesを活用したリアクティブな状態管理や、仮想DOMを使用しないコンポーネントの開発を経験しています。',
    },
    {
        name: 'Next.js',
        category: 'Frontend',
        description:
            '学習支援を目的としたWebアプリケーションの開発で使用。HonoによるAPI、データベース、認証基盤を組み合わせた開発を経験しています。',
    },
    {
        name: 'Nuxt',
        category: 'Frontend',
        description:
            'Nuxt 3を用いたWebアプリケーションを開発。Vueによる画面構築に加え、Clerkによる認証やTursoとの連携を経験しました。',
    },
    {
        name: 'SvelteKit',
        category: 'Frontend',
        description:
            'Hono、Drizzle ORM、Tursoと組み合わせたWebアプリケーションを開発。画面構築からAPI・データベースとの連携まで経験しています。',
    },
    {
        name: 'Astro',
        category: 'Frontend',
        description:
            'ポートフォリオサイトの構築に使用。静的コンテンツを中心に構成し、検索やフィルタリングなどの動的な部分にはReactを組み合わせています。',
    },
    {
        name: 'React Native',
        category: 'Frontend',
        description:
            '卒業研究でスマートフォン向けアプリケーションを開発中。Reactの知識を活かしたモバイルUIの設計・実装に取り組んでいます。',
    },
    {
        name: 'Expo',
        category: 'Frontend',
        description:
            'React Nativeによるモバイルアプリ開発で使用。Expo Routerを利用した画面構成や、Honoで構築したAPIとの連携に取り組んでいます。',
    },

    // Backend
    {
        name: 'Hono',
        category: 'Backend',
        description:
            'Cloudflare Workers上で動作するREST APIの構築に使用。Drizzle ORM、Better Auth、Workers AI、Next.jsなどと組み合わせた開発を経験しています。',
    },
    {
        name: 'Node.js',
        category: 'Backend',
        description:
            'JavaScript・TypeScriptによる開発環境やサーバーサイド処理で使用。UnityのWebGL成果物をローカルサーバーで配信した際にも利用しました。',
    },
    {
        name: 'Drizzle ORM',
        category: 'Backend',
        description:
            'Tursoなどのデータベースへのアクセスに使用。TypeScriptによるスキーマ定義や型安全なデータ操作を経験しています。',
    },
    {
        name: 'Zod',
        category: 'Backend',
        description:
            'Honoで構築したAPIの入力検証に使用。Zod OpenAPIなどを通じて、スキーマに基づくバリデーションや型定義に取り組んでいます。',
    },
    {
        name: 'Clerk',
        category: 'Backend',
        description:
            'Nuxt 3を使用したWebアプリケーションの認証基盤として採用。外部認証サービスとアプリケーションの連携を経験しました。',
    },
    {
        name: 'Better Auth',
        category: 'Backend',
        description:
            '学習支援Webアプリケーションの認証基盤として使用。Next.jsやHono、Cloudflare D1と組み合わせた開発を経験しています。',
    },
    {
        name: 'SQLite',
        category: 'Backend',
        description:
            'Cloudflare D1やTursoを通じて使用。Webアプリケーションのデータ保存・取得や、ORMを介したデータ操作を経験しています。',
    },

    // Cloud
    {
        name: 'Cloudflare Workers',
        category: 'Cloud',
        description:
            'Honoを利用したサーバーレスAPIの実行基盤として使用。Wranglerによるローカル開発や、Workers AIと連携したバックエンド処理を検証しています。',
    },
    {
        name: 'Cloudflare D1',
        category: 'Cloud',
        description:
            '学習支援Webアプリケーションのデータベースとして使用。Workers上のAPIと連携したデータの保存・取得を経験しています。',
    },
    {
        name: 'Cloudflare Workers AI',
        category: 'Cloud',
        description:
            '卒業研究で画像分類AIのPoCに使用。Honoからモデルを呼び出し、人物の有無や、ゴミが単一・複数・不明のいずれに当たるかを判定する処理を検証しました。',
    },
    {
        name: 'Turso',
        category: 'Cloud',
        description:
            'Nuxt 3やSvelteKitによるWebアプリケーションのデータベースとして使用。Drizzle ORMとの連携によるデータ操作も経験しています。',
    },

    // Other
    {
        name: 'Git',
        category: 'Other',
        description:
            '個人開発やチーム開発に使用。ソースコードのバージョン管理や変更履歴の管理を行っています。',
    },
    {
        name: 'Linux',
        category: 'Other',
        description:
            '学校でのLinux実習に加え、Ubuntuの仮想マシン2台を用いたセキュリティ実験を経験。CLIによる基本操作やネットワーク関連の検証を行いました。',
    },
    {
        name: 'pnpm',
        category: 'Other',
        description:
            'Webアプリケーションのパッケージ管理に使用。Turborepoと組み合わせ、モバイルアプリとAPIを同一リポジトリで管理する構成を採用しています。',
    },
    {
        name: 'Turborepo',
        category: 'Other',
        description:
            '卒業研究のモノレポ構成で使用。ExpoによるモバイルアプリとHonoによるAPIを、apps/mobile・apps/apiとして管理しています。',
    },
    {
        name: 'Unity',
        category: 'Other',
        description:
            'ゲーム開発で使用。WebGLへのビルドに加え、npx serveとngrokを組み合わせ、ローカル環境の成果物を外部から閲覧できるようにした経験があります。',
    },
    {
        name: 'Mermaid',
        category: 'Other',
        description:
            'アプリケーションの設計や処理フローの可視化に使用。シーケンス図やシステム構成図などを通じて、構造や動作の整理に活用しています。',
    },
];
---

<Layout title="Skills">
    <div class="mx-auto min-h-[calc(100vh-149px)] w-[calc(100%-48px)] max-w-240 pt-20 pb-25 max-[600px]:pt-14 max-[600px]:pb-17.5">
        <header class="mb-12 max-[600px]:mb-8">
            <h1 class="text-[clamp(32px,5vw,46px)] leading-[1.3] font-bold">
                Skills
            </h1>
        </header>
        <SkillsExplorer skills={items} client:load />
    </div>
</Layout>
